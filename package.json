{
  "name": "threshold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "contracts:deploy": "tsx scripts/deploy.ts",
    "contracts:smoke": "tsx scripts/smoke.ts",
